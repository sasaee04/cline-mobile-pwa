# Runtime server configuration
# Leave at 127.0.0.1 for use only on this computer.
CLINE_HOST=127.0.0.1
PORT=3001

# Optional fixed secret. If omitted, the server generates and prints a fresh token at startup.
CLINE_MOBILE_TOKEN=

# Choose a project directory the agent may work in.
CLINE_WORKSPACE_ROOT=.

# Cline provider/model credentials. Set these to match your provider.
CLINE_PROVIDER_ID=cline
CLINE_MODEL_ID=
CLINE_API_KEY=

# Origins allowed to call the API (comma separated).
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tool approval requests are denied automatically after this timeout.
CLINE_APPROVAL_TIMEOUT_MS=120000
